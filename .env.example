# --- Подключение к 1С OData ---
ODATA_BASE_URL=http://<host>/<база>/odata/standard.odata
ODATA_LOGIN=
ODATA_PASSWORD=
ODATA_TIMEOUT=60
ODATA_MAX_RETRIES=3
ODATA_CONCURRENCY=8

# GUID видов цен для создания/обновления товаров.
# Можно перечислить несколько через запятую — цена запишется
# во все указанные виды цен. Ref_Key брать из Catalog_ВидыЦен.
# Для совместимости поддерживается ODATA_PRICE_TYPE_GUID (один).
ODATA_PRICE_TYPE_GUIDS=
# GUID доп. свойства "Цвет" в 1С. По умолчанию — стандартный
# для базы Intreid_UNF_Copy4, при необходимости переопредели.
ODATA_COLOR_PROP_GUID=09aaacc4-32e5-11ef-9698-000c297d6e66

# --- Порт веб-морды на хосте ---
WEB_PORT=8080

# --- Session-cookie для авторизации в панели ---
# Обязательно задай длинную случайную строку.
# Без секрета сгенерируется временный — сессии будут падать при рестарте.
SESSION_SECRET=
SESSION_MAX_AGE=2592000
SESSION_COOKIE_SECURE=false

# --- Owner (создаётся автоматически при первом запуске) ---
OWNER_USERNAME=admin
OWNER_PASSWORD=

# Временно отключить проверку авторизации (все /api/* открыты,
# LoginPage не показывается). Для включения обратно — true или удалить.
AUTH_ENABLED=true

# --- Фоновая синхронизация ---
SYNC_ENABLED=true
SYNC_INTERVAL_HOURS=2
SYNC_BACKFILL_DAYS=730
SYNC_REFRESH_DAYS=14
SYNC_CHUNK_DAYS=30
SYNC_FULL_REBUILD_DAYS=7
