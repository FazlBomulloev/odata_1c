# --- Подключение к 1С OData ---
ODATA_BASE_URL=http://<host>/<база>/odata/standard.odata
ODATA_LOGIN=
ODATA_PASSWORD=
ODATA_TIMEOUT=60
ODATA_MAX_RETRIES=3
ODATA_CONCURRENCY=8

# --- Порт веб-морды на хосте ---
WEB_PORT=8080

# --- Session-cookie для авторизации в панели ---
# Обязательно задай длинную случайную строку.
# Без секрета сгенерируется временный — сессии будут падать при рестарте.
SESSION_SECRET=
SESSION_MAX_AGE=2592000
SESSION_COOKIE_SECURE=false

# --- Owner (создаётся автоматически при первом запуске) ---
OWNER_USERNAME=admin
OWNER_PASSWORD=

# --- Фоновая синхронизация ---
SYNC_ENABLED=true
SYNC_INTERVAL_HOURS=2
SYNC_BACKFILL_DAYS=730
SYNC_REFRESH_DAYS=14
SYNC_CHUNK_DAYS=30
SYNC_FULL_REBUILD_DAYS=7
